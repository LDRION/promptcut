# Скопируйте в .env (в корне репозитория) и впишите свои значения. Настоящий .env в git не попадает.
# Движок читает его при старте (engine/src/env.ts); переменные, уже заданные в оболочке, главнее.

# Ключ Siberi AI — нужен всем ИИ-шагам: стилисту (читает эталон), режиссёру (пишет EDL)
# и критику (проверяет рендер). Без него движок всё равно рендерит в детерминированном режиме.
SIBERI_API_KEY=sk-siberi-your-key-here

# Адрес своего сервера Siberi (github.com/LDRION/siberi). По умолчанию — локальный, запущенный с PORT=5005.
# SIBERI_BASE_URL=http://127.0.0.1:5005/api/v1/ai

# Модель faster-whisper для расшифровки исходников (tiny | base | small | medium | large-v3).
# PROMPTCUT_WHISPER=small

# Порт веб-интерфейса.
# PORT=5174
