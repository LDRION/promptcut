# Copy to .env (repo root) and fill in real values. Never commit the real .env — it's gitignored.
# The engine loads it on startup (engine/src/env.ts); variables already set in the shell win.

# Siberi AI (siberi.online) API key — powers every AI step: the stylist (reads the
# reference edit), the director (authors the EDL) and the critic (reviews the render).
# Without it the engine still renders, in deterministic auto mode.
SIBERI_API_KEY=sk-siberi-your-key-here

# Override the Siberi AI endpoint. Optional — defaults to the production API.
# SIBERI_BASE_URL=https://siberi.online/api/v1/ai

# faster-whisper model for the footage transcript (tiny | base | small | medium | large-v3).
# PROMPTCUT_WHISPER=small

# Web UI port.
# PORT=5174
