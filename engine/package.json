{
  "name": "promptcut-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Beat-synced montage engine conducted by Siberi AI: reads a reference edit, directs the cut, renders, reviews and fixes.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "make": "tsx src/edit/cli.ts make",
    "plan": "tsx src/edit/cli.ts plan",
    "render": "tsx src/edit/cli.ts render",
    "style": "tsx src/edit/cli.ts style",
    "web": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "music-tempo": "^1.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
